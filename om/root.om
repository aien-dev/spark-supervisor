global xb uchar 262144
global sa uchar 1024
global bp uchar 32768
global rv ulong 64
global gid ulong 32
global stat4 uchar 4
global pfd uchar 8
note Slots of rv.
const RUID ulong 0
const RGID ulong 1
const RNG ulong 2
const RMEM ulong 3
const RSWP ulong 4
const RTSK ulong 5
const RCPU ulong 6
const RNOF ulong 7
const RNIC ulong 8
const RUMK ulong 9
const RNET ulong 10
const RNDF ulong 11
const RNS ulong 12
const RERR ulong 13
const RMDW ulong 14
const RFAM ulong 15
const RXL ulong 16
const RSYS ulong 17
const RNS0 ulong 18
const RNS1 ulong 19
const RBPN ulong 20
const RCHK ulong 21
const RWAT ulong 22
const RDIR ulong 23
const RXN ulong 24
const RFDA ulong 25
const RFDS ulong 26
const RSEC ulong 27
const RCRD ulong 28
const RUNL ulong 29
const RGX ulong 30

note --------------------------------------------------------------------- refusal

fn efl to void
oflush 2
end

fn refuse t view uchar * to int
ostr eprefix
ostr t
ostr tnl
efl
ret 2
end

fn refpth t view uchar * to int
ostr eprefix
ostr t
opth
ostr tnl
efl
ret 2
end

fn refln t view uchar * to int
ostr eprefix
ostr eline
onum long get gu GLNO
ostr tsp
ostr t
ostr tnl
efl
ret 2
end

note ---------------------------------------------------------------- service file

global nmb uchar 64
global unb uchar 64

fn pname to void
for i ulong get gu GSV
pb get nmb i
end
end

fn svcpth to void
pset
pstr tsdir
pname
pstr tsvc
end

fn okname2 n ulong to bool
if or eq n 0 gt n 32
ret false
end
if eq get av 0 45
ret false
end
for i ulong n
c = get av i
if not or or and ge c 97 le c 122 and ge c 48 le c 57 eq c 45
ret false
end
end
ret true
end

note Host layout: every program and directory the helper relies on is root-owned and not
note group/other-writable (aien-run-exec standard), checked before anything else runs.
fn layout1 t view uchar * kind ulong to bool
pset
pstr t
if not rootok kind
ret false
end
ret rootdirs
end

fn hostok to int
if not layout1 tbwrap 1
ret refpth elayout
end
if not layout1 tsetpr 1
ret refpth elayout
end
if not layout1 tprlim 1
ret refpth elayout
end
if not layout1 tnice 1
ret refpth elayout
end
if not layout1 tnft 1
ret refpth elayout
end
if not layout1 twatch 1
ret refpth elayout
end
if not layout1 tself 1
ret refpth elayout
end
if not layout1 tpasswd 1
ret refpth elayout
end
if not layout1 tgroup 1
ret refpth elayout
end
svcpth
if not rootok 1
ret refpth elayout
end
if not rootdirs
ret refpth elayout
end
ret 0
end

note ------------------------------------------------------------- passwd and group

fn rdx to long
fd = popen ORDO 0
if lt fd 0
ret fd
end
n = ulong 0
while true bound 100000
r = read int fd xb n sub len xb n
if le r 0
break
end
n = add n ulong r
if eq n len xb
c = fclose int fd
ret -27
end
end
c = fclose int fd
ret long n
end

note Compare the colon field xb[a..b) with word k of the current line.
fn xweq a ulong b ulong k ulong to bool
if ne sub b a wlen k
ret false
end
s = get ws k
for i ulong sub b a
if ne get xb add a i get sf add s i
ret false
end
end
ret true
end

fn xnum a ulong b ulong to long
if or eq a b gt sub b a 9
ret -1
end
v = long 0
p = a
while lt p b bound 16
c = get xb p
if or lt c 48 gt c 57
ret -1
end
v = add mul v 10 long sub c 48
p = add p 1
end
ret v
end

fn xcolon p ulong e ulong to ulong
q = p
while lt q e bound 999999
c = get xb q
if or eq c 58 eq c 10
ret q
end
q = add q 1
end
ret e
end

note Find the line of xb (n bytes) whose first field equals word k; returns its start or n.
fn xfind n ulong k ulong to ulong
p = ulong 0
while lt p n bound 999999
f = xcolon p n
if xweq p f k
ret p
end
q = p
while lt q n bound 999999
if eq get xb q 10
break
end
q = add q 1
end
p = add q 1
end
ret n
end

note Field i (0-based) of the colon line at p as a number, or -1.
fn xfield p ulong n ulong i ulong to long
a = p
for j ulong i
a = add xcolon a n 1
if gt a n
ret -1
end
end
b = xcolon a n
ret xnum a b
end

fn lookuser k ulong to bool
pset
pstr tpasswd
r = rdx
if lt r 0
ret false
end
n = ulong r
p = xfind n k
if ge p n
ret false
end
u = xfield p n 2
g = xfield p n 3
if or lt u 1 gt u 999
ret false
end
if lt g 100
ret false
end
put rv RUID ulong u
put rv RGID ulong g
ret true
end

note Groups that are root in disguise are refused by name; any gid below 100 is refused.
text gdocker "docker"
text gsudo "sudo"
text gadm "adm"
text gdisk "disk"
text glxd "lxd"
text gkvm "kvm"
text gshadow "shadow"
text glibvirt "libvirt"
text gsysj "systemd-journal"

fn badgrp k ulong to bool
if or or wis k gdocker wis k gsudo or wis k gadm wis k gdisk
ret true
end
if or or wis k glxd wis k gkvm or wis k gshadow or wis k glibvirt wis k gsysj
ret true
end
ret false
end

fn lookgrp k ulong to long
if badgrp k
ret -1
end
pset
pstr tgroup
r = rdx
if lt r 0
ret -1
end
n = ulong r
p = xfind n k
if ge p n
ret -1
end
g = xfield p n 2
if lt g 100
ret -1
end
ret g
end

note ------------------------------------------------------------------- validation

fn kis t view uchar * to bool
ret and gt nw 0 wis 0 t
end

fn pfx k ulong t view uchar * to bool
n = wlen k
if lt n len t
ret false
end
s = get ws k
for i ulong len t
if ne get sf add s i get t i
ret false
end
end
if eq n len t
ret true
end
c = get sf add s len t
ret or eq c 47 eq get t sub len t 1 47
end

fn badro k ulong to bool
if or or pfx k phome pfx k proot or pfx k pproc pfx k psys
ret true
end
if or or pfx k pdev pfx k ptmp or pfx k pruser pfx k pasup
ret true
end
ret false
end

fn okrw k ulong to bool
if not okpath k
ret false
end
if badro k
ret false
end
if not or or pfx k pvar pfx k psrv pfx k prun
ret false
end
ret gt wlen k 5
end

fn addrch c uchar to bool
if or and ge c 48 le c 57 and ge c 97 le c 102
ret true
end
ret or or eq c 46 eq c 58 eq c 47
end

fn okaddr k ulong to bool
n = wlen k
if or eq n 0 gt n 64
ret false
end
dots = false
for i ulong n
c = wch k i
if not addrch c
ret false
end
if or eq c 46 eq c 58
dots = true
end
end
ret dots
end

fn isv6 k ulong to bool
for i ulong wlen k
if eq wch k i 58
ret true
end
end
ret false
end

fn okport k ulong to bool
v = wnum k
ret and ge v 1 le v 65535
end

fn keych c uchar to bool
if or and ge c 65 le c 90 and ge c 97 le c 122
ret true
end
ret or and ge c 48 le c 57 eq c 95
end

fn isldpre s ulong e ulong to bool
if lt sub e s 3
ret false
end
a = eq get sf s 76
b = eq get sf add s 1 68
c = eq get sf add s 2 95
ret and and a b c
end

fn okenvkey s ulong e ulong to bool
if or eq s e gt sub e s 64
ret false
end
p = s
while lt p e bound 70
if not keych get sf p
ret false
end
p = add p 1
end
ret not isldpre s e
end

fn envkeyend k ulong to ulong
s = get ws k
e = get we k
p = s
while lt p e bound 999999
if eq get sf p 61
ret p
end
p = add p 1
end
ret e
end

fn numarg k ulong lo long hi long to bool
v = wnum k
ret and ge v lo le v hi
end

note A root-owned, not group/other-writable regular file (and its directories) named by word k.
fn rootfile k ulong to bool
pset
pword k
if not rootok 1
ret false
end
ret rootdirs
end

note Validate the daemon keys (shared with aien-supervise) on the current line; 1 ok, 0 no
note match, 2 error already reported.
fn vdaemon to ulong
if kis ktype
if or ne nw 2 not or wis 1 wsimple wis 1 woneshot
ret 2
end
ret 1
end
if kis krst
if or ne nw 2 not or or wis 1 walways wis 1 wonfail wis 1 wno
ret 2
end
ret 1
end
if kis kback
if or ne nw 3 or not numarg 1 1 86400 not numarg 2 1 86400
ret 2
end
ret 1
end
if or or kis kevery kis kdelay or kis ktmo kis kstop
if or ne nw 2 not numarg 1 0 31536000
ret 2
end
ret 1
end
if or kis klmax kis klkeep
if or ne nw 2 not numarg 1 1 1099511627776
ret 2
end
ret 1
end
if kis kauto
if or ne nw 2 not or wis 1 wyes wis 1 wno
ret 2
end
ret 1
end
ret 0
end

fn vexec to bool
if lt nw 2
ret false
end
if not okpath 1
ret false
end
if not rootfile 1
ret false
end
put rv RXL get gu GLNO
ret true
end

fn vwatch to bool
if ne nw 5
ret false
end
if not okpath 1
ret false
end
if or eq wlen 2 0 gt wlen 2 64
ret false
end
put rv RWAT 1
if not numarg 4 0 86400
ret false
end
ret numarg 3 1 86400
end

fn vuser to bool
if ne nw 2
ret false
end
if not lookuser 1
ret false
end
n = wlen 1
if gt n 32
ret false
end
for i ulong n
put unb i wch 1 i
end
put rv RUNL n
ret true
end

fn addgid g ulong to bool
n = get rv RNG
if ge n len gid
ret false
end
put gid n g
put rv RNG add n 1
ret true
end

fn vgroups to bool
if lt nw 2
ret false
end
for i ulong sub nw 1
g = lookgrp add i 1
if lt g 0
ret false
end
if not addgid ulong g
ret false
end
end
ret true
end

fn vgroup to bool
if ne nw 2
ret false
end
g = lookgrp 1
if lt g 0
ret false
end
put rv RGX ulong g
ret true
end

note xb[a..b) equals text t.
fn xeqt a ulong b ulong t view uchar * to bool
if ne sub b a len t
ret false
end
for i ulong len t
if ne get xb add a i get t i
ret false
end
end
ret true
end

fn xbadgrp a ulong b ulong to bool
if or or xeqt a b gdocker xeqt a b gsudo or xeqt a b gadm xeqt a b gdisk
ret true
end
if or or xeqt a b glxd xeqt a b gkvm or xeqt a b gshadow or xeqt a b glibvirt xeqt a b gsysj
ret true
end
ret false
end

note xb[a..b) equals the service user's name.
fn xisuser a ulong b ulong to bool
if ne sub b a get rv RUNL
ret false
end
for i ulong sub b a
if ne get xb add a i get unb i
ret false
end
end
ret true
end

fn lnend p ulong n ulong to ulong
q = p
while lt q n bound 999999
if eq get xb q 10
ret q
end
q = add q 1
end
ret n
end

note Is the user named in the member list (field 3) of the /etc/group line at p..e?
fn ingrp p ulong e ulong to bool
a = p
for j ulong 3
a = add xcolon a e 1
if gt a e
ret false
end
end
while lt a e bound 99999
b = a
while and lt b e ne get xb b 44 bound 99999
b = add b 1
end
if xisuser a b
ret true
end
a = add b 1
end
ret false
end

note initgroups(3) done here so every supplementary group is checked: the user's member groups
note from /etc/group are added; a privileged one (gid < 100 or a root-equivalent name) refuses.
fn initgr to bool
pset
pstr tgroup
r = rdx
if lt r 0
ret false
end
n = ulong r
p = ulong 0
while lt p n bound 99999
e = lnend p n
if ingrp p e
f = xcolon p e
g = xfield p e 2
if or lt g 100 xbadgrp p f
ret false
end
if not addgid ulong g
ret false
end
end
p = add e 1
end
ret true
end

fn vsecret to bool
if ne nw 3
ret false
end
if not okname get ws 1 get we 1
ret false
end
if not okpath 2
ret false
end
pset
pword 2
if not rootok 1
ret false
end
if ne and stmode 63 0
ret false
end
if not rootdirs
ret false
end
put rv RSEC add get rv RSEC 1
ret le get rv RSEC 8
end

fn vnet to bool
if ne nw 2
ret false
end
if wis 1 whost
put rv RNET 0
ret true
end
if wis 1 wnone
put rv RNET 1
ret true
end
if wis 1 wfilter
put rv RNET 2
ret true
end
ret false
end

fn vallow to bool
if or lt nw 2 gt nw 3
ret false
end
if not okaddr 1
ret false
end
if eq nw 3
ret okport 2
end
ret true
end

fn vlisten to bool
if lt nw 3
ret false
end
if not okport 1
ret false
end
for i ulong sub nw 2
if not okaddr add i 2
ret false
end
end
ret true
end

fn vsysg to bool
if lt nw 2
ret false
end
for i ulong sub nw 1
k = add i 1
if not or or wis k gss wis k gmnt wis k gns
ret false
end
end
put rv RSYS 1
ret true
end

fn vsysd to bool
if lt nw 2
ret false
end
for i ulong sub nw 1
k = add i 1
if not or wis k gpriv wis k gres
ret false
end
end
ret true
end

fn vfam to bool
if lt nw 2
ret false
end
m = ulong 0
for i ulong sub nw 1
k = add i 1
if wis k funix
m = or m 1
else
if wis k finet
m = or m 2
else
if wis k finet6
m = or m 4
else
if wis k fnetl
m = or m 8
else
ret false
end
end
end
end
end
put rv RFAM m
ret true
end

fn yesno to long
if ne nw 2
ret -1
end
if wis 1 wyes
ret 1
end
if wis 1 wno
ret 0
end
ret -1
end

note Sandbox keys, part 1. Returns 1 ok, 0 no match, 2 bad value, 3 bad path.
fn vbox1 to ulong
if kis kexec
if vexec
ret 1
end
ret 3
end
if kis kenv
if ne nw 2
ret 2
end
e = envkeyend 1
if or not okenvkey get ws 1 e eq e get we 1
ret 2
end
ret 1
end
if kis kdir
if or ne nw 2 not okpath 1
ret 3
end
put rv RDIR get gu GLNO
ret 1
end
if kis kumask
v = woct 1
if or ne nw 2 or lt v 0 gt v 511
ret 2
end
put rv RUMK ulong v
ret 1
end
if kis knice
if or ne nw 2 not numarg 1 0 19
ret 2
end
put rv RNIC ulong wnum 1
ret 1
end
if kis kwatch
if vwatch
ret 1
end
ret 2
end
ret 0
end

fn vbox2 to ulong
if kis kuser
if vuser
ret 1
end
ret 4
