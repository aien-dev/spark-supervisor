text texe "/exe"

note bwrap's own processes (namespace monitor and init) run as the service user too; stop sends
note the signal past them to the service, whose exit then ends the sandbox.
fn isbwrap pid long to bool
pset
pstr tproc
pnum ulong pid
pstr texe
r = readlnk pth 0 plen ebuf 0 len ebuf
if ne r long len tbwrap
ret false
end
for i ulong len tbwrap
if ne get ebuf i get tbwrap i
ret false
end
end
ret true
end

fn dokill to int
cgleaf
pstr ckill
abreset
abstr c1
w = wrfile
for i ulong 100
if not cgpopulated
ret 0
end
s = sleepns 50000000
end
ret 1
end

fn main to int
if or ne getuid 0 ne geteuid 0
ret refuse enotroot
end
if ne argcnt 3
ret refuse eusage
end
n = arg 2
if not okname2 n
ret refuse ename
end
for i ulong n
put nmb i get av i
end
put gu GSV n
v = arg 1
r = loadsvc
if ne r 0
ret r
end
v = arg 1
if aveq v vrun
ret dorun
end
if aveq v vcheck
ret docheck
end
if aveq v vstop
ret dostop 15
end
if aveq v vkill
ret dokill
end
ret refuse eusage
end
